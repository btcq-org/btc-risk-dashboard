# Copy to .env and adjust. All settings can also be set in the environment.
# Python code reads from indexer/config.py (which uses os.getenv with these defaults).

# ---------------------------------------------------------------------------
# Bitcoin RPC (Bitcoin Core)
# ---------------------------------------------------------------------------
# NETWORK=testnet
# RPC_USER=admin
# RPC_PASSWORD=pass
# RPC_HOST=127.0.0.1
# RPC_PORT=18332

# Block source: rpc (default) or blk (read from blk*.dat files)
# BLOCK_SOURCE=rpc
# BLOCKS_DIR=/path/to/data-bitcoin/blocks
# BITCOIN_DIR=/path/to/data-bitcoin

# ---------------------------------------------------------------------------
# Database (PostgreSQL / TimescaleDB)
# ---------------------------------------------------------------------------
# There are no default passwords: docker compose and the indexer/API refuse to
# start until these are set. Generate each one with: openssl rand -hex 32
# Superuser, for administration only (docker-compose pg service).
POSTGRES_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=postgres
# Indexer role (owns the schema, not a superuser).
# DB_USER=indexer
DB_PASS=
# Read-only role used by indexer/api.py.
# API_DB_USER=api_ro
API_DB_PASS=

# ---------------------------------------------------------------------------
# Indexer tuning
# ---------------------------------------------------------------------------
# CHUNK_SIZE=10
# MAX_RETRIES=5
# DB_PAGE_ROWS=1000
# POLL_INTERVAL=1.0
# RECONNECT_DELAY=5.0

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------
# IS_UTXO=0
# IS_RECALC=0
